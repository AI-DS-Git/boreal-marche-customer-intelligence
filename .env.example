# Copy to .env (never commit .env). Every value has a safe local default.
POSTGRES_PASSWORD=change_me_locally
GIT_SHA=local
# Optional: Slack/Discord/Teams incoming-webhook URL for drift and error alerts.
ALERT_WEBHOOK_URL=
# Assistant (Head C). The rule provider always works. Providers openai / ollama are enabled only
# when configured. Retrieval: lexical | hashing (offline default) | openai | ollama.
OPENAI_API_KEY=
OLLAMA_BASE_URL=
EMBEDDING_PROVIDER=hashing
# Similarity floor below which a policy question is refused; calibrate with
# `python scripts/eval_assistant.py --calibrate` after changing EMBEDDING_PROVIDER.
EMBEDDING_FLOOR=
# Set true in production to refuse to start if scikit-learn differs from the training version.
STRICT_LIBRARY_VERSIONS=false
